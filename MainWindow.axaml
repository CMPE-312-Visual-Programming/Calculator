<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="350"
        x:Class="Calculator.MainWindow"
        Title="Calculator">
    <!-- <Window.Styles> -->
    <!--     <StyleInclude Source="Styles/GlobalStyle.axaml"/> -->
    <!-- </Window.Styles> -->
    <DockPanel> 
        <StackPanel DockPanel.Dock="Top" Classes="display">
            <TextBlock x:Name="Calculation" Text="0" />
            <TextBlock x:Name="Result" Text="0" />
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" RowDefinitions="*,*" ColumnDefinitions="3*,*"  Classes="buttonLayout">
            <StackPanel Grid.Row="0" Grid.Column="0" Classes="clear">
                <Button Content="←" Classes="backButton" Click="OnBackspaceClick"/>
                <Button Content="C" Classes="clearButton" Click="OnClearClick"/>
            </StackPanel>
            <Grid Grid.Column="0" Grid.Row="1" RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*">
                <Button Grid.Row="0" Grid.Column="0" Content="7" Click="OnNumberButtonClick"/>
                <Button Grid.Row="0" Grid.Column="1" Content="8" Click="OnNumberButtonClick"/>
                <Button Grid.Row="0" Grid.Column="2" Content="9" Click="OnNumberButtonClick"/>
                <Button Grid.Row="1" Grid.Column="0" Content="4" Click="OnNumberButtonClick"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Click="OnNumberButtonClick"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Click="OnNumberButtonClick"/>
                <Button Grid.Row="2" Grid.Column="0" Content="1" Click="OnNumberButtonClick"/>
                <Button Grid.Row="2" Grid.Column="1" Content="2" Click="OnNumberButtonClick"/>
                <Button Grid.Row="2" Grid.Column="2" Content="3" Click="OnNumberButtonClick"/>
                <Button Grid.Row="3" Grid.Column="1" Content="0" Click="OnNumberButtonClick"/>
                <Button Grid.Row="3" Grid.Column="2" Content="." Click="OnNumberButtonClick"/>
            </Grid>
            <StackPanel Grid.Column="1" Grid.Row="1">
                <Button Content="/" Click="OnCalculateClick"/>
                <Button Content="*" Click="OnCalculateClick"/>
                <Button Content="+" Click="OnCalculateClick"/>
                <Button Content="-" Click="OnCalculateClick"/>
                <Button Content="=" Click="OnCalculateClick"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
