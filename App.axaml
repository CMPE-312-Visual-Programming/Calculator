<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Calculator.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Styles/GlobalStyle.axaml"/> 
        <!-- If you want to use the style in every page/ every window you need to include in here otherwise put this part into window.axaml file inside <Window.Styles></Window.Styles> --> 
    </Application.Styles>
</Application>